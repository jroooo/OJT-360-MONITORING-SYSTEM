<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /OJT-360-MONITORING-SYSTEM/

    # Employee Dashboard
    RewriteRule ^Employee-Dashboard/?$ dashboard(employee).php [L]

    # Employee Settings
    RewriteRule ^Employee-Settings/?$ settings.php [L]
</IfModule>

<Files "gemini.local.php">
    Require all denied
</Files>

<Files "groq.local.php">
    Require all denied
</Files>